# --- LLM (OpenAI, exigence du hackathon) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Kafka ---
# Local (docker compose) :
KAFKA_BOOTSTRAP=127.0.0.1:9092
# Aiven : host:port du service Kafka, + télécharger ca.pem, service.cert, service.key dans ./certs
# KAFKA_BOOTSTRAP=kafka-xxx.aivencloud.com:12345
# KAFKA_SSL_DIR=certs

# --- ClickHouse (interface HTTP) ---
CLICKHOUSE_URL=http://127.0.0.1:8124
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Aiven : CLICKHOUSE_URL=https://clickhouse-xxx.aivencloud.com:12345 (port "ClickHouse HTTPS"), user avnadmin

# --- PostgreSQL ---
PG_URL=postgresql://postgres:postgres@127.0.0.1:5442/fashion
# Aiven : PG_URL=postgresql://avnadmin:xxx@pg-xxx.aivencloud.com:12345/defaultdb?sslmode=require

# --- Simulation ---
TICK_SECONDS=1.0
SIM_MINUTES_PER_TICK=10
